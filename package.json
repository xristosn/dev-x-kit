  "scripts": {
    "copy:editor-assets": "node scripts/copy-editor-assets.ts",
    "dev": "pnpm copy:editor-assets && next dev",
    "build": "pnpm copy:editor-assets && next build",
    "start": "next start",
    "lint": "eslint && node -e \"console.log('Lint passed')\"",
    "lint:fix": "eslint --fix && node -e \"console.log('Lint fix passed')\"",
    "format": "prettier --write ./src && node -e \"console.log('Format passed')\"",
    "update-deps": "pnpm update --interactive --latest",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "next typegen && tsc --noEmit && node -e \"console.log('Typecheck passed')\""
  },
